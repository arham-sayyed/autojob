GROQ_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
RESUME_PATH=./data/resume.pdf
DAILY_SEND_CAP=25
DAILY_WHATSAPP_CAP=25
FOLLOW_UP_AFTER_DAYS=7
SEARCH_CITIES=Mumbai,Pune,Bangalore
SEARCH_TERMS=software company,startup,web development company,SaaS company
# whatsapp-web.js authenticates via QR code scan on first run (session persisted to disk
# under .wwebjs_auth/ via LocalAuth) — no API key needed.

# Optional. Your own WhatsApp number (with country code, e.g. 9198XXXXXXXX) to receive
# test sends when AUTOPILOT=false, instead of the real company. Leave blank to just log
# the message that would have been sent.
TEST_WHATSAPP_NUMBER=

# Master kill switch. Defaults to false: every stage (email send, whatsapp send) runs in a
# safe/manual-confirm mode. Set to true only once you've reviewed real output end-to-end.
AUTOPILOT=false
